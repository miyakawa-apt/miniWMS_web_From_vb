# 開発用の設定例。複製して .env を作り、値を設定する（.env はコミットしない）。
# パスワードなどの実値はここに書かない。
POSTGRES_DB=miniwms
POSTGRES_USER=miniwms
POSTGRES_PASSWORD=
POSTGRES_PORT=15432

# バックエンド（Spring Boot）が読む接続先。上の値に合わせる。
DB_URL=jdbc:postgresql://localhost:15432/miniwms
SPRING_DATASOURCE_USERNAME=miniwms
SPRING_DATASOURCE_PASSWORD=
